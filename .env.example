# Local-only dashboard connection to the Windows agent API.
# Leave this unset in Vercel so the browser uses the same-origin /api/v1 cloud API.
NEXT_PUBLIC_GHOST_LOCAL_API_URL=http://127.0.0.1:8765

# Windows local agent overrides (normally stored by pair.py in %APPDATA%\\GHOST\\agent.json).
# GHOST_CLOUD_API_URL=https://your-ghost-project.vercel.app
# GHOST_DEVICE_TOKEN=stored-by-pair-command-do-not-commit
# MT5_COMMON_FILES_DIR=C:\\Users\\YOUR_USER\\AppData\\Roaming\\MetaQuotes\\Terminal\\Common\\Files
